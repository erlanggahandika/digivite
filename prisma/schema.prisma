generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  username  String?
  pin       String?
  role      Int?
  saldo     Int?      @default(0)
  tokenJwt  String?   @db.Text
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  notifikasi   Notifikasi[]
  aktivitas     Aktivitas[]
  hakakses  HakAkses? @relation(fields: [hakAksesId], references: [id])
  hakAksesId Int?     @unique
}

model HakAkses {
  id           Int     @id @default(autoincrement())
  statuspegawai Boolean?
  statuscontent Boolean?
  statusadmin  Boolean?
  statususer   Boolean?
  pinAdmin     String?
  user         User?
}

model Notifikasi {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  name      String?
  email     String?
  pesan     String
  tipe      String   
  dibaca    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Aktivitas {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  method    String
  route     String
  timestamp DateTime @default(now())
}

model ConnectTele {
  id        Int      @id @default(autoincrement())
  bot_token     String?
  chat_id       String?
  jam           String?
  menit         String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model PinAdmin {
  id        Int      @id @default(autoincrement())
  pin       String?
  cron_schedule String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Maintance {
  id        Int      @id @default(autoincrement())
  open      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


